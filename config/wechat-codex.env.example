# Copy this file to your own environment loader or service EnvironmentFile.

# Workspace used when a WeChat route has no custom /cwd.
WECHAT_CODEX_CWD=/path/to/workspace

# Codex executable. Use an absolute path if the service environment has a small PATH.
WECHAT_CODEX_BIN=codex

# UA-style identity carried in iLink base_info.bot_agent for Tencent-side observability.
WECHAT_CODEX_BOT_AGENT=WechatCodexBridge/0.1.0

# Arguments before `exec`, rarely needed.
WECHAT_CODEX_ROOT_ARGS=

# Codex execution surface:
# - exec: stable non-interactive CLI path
# - app-server: native Codex app-server path with skills such as imagegen
# - auto: app-server for image/artifact prompts, exec for other prompts
WECHAT_CODEX_RUNNER=exec
WECHAT_CODEX_MODEL=gpt-5.5
WECHAT_CODEX_REASONING_EFFORT=xhigh
WECHAT_CODEX_APP_SERVER_TIMEOUT_MS=900000

# Arguments for new Codex runs.
WECHAT_CODEX_EXEC_ARGS=--json -m gpt-5.5 -c model_reasoning_effort="xhigh" --skip-git-repo-check

# Arguments for resumed Codex runs.
WECHAT_CODEX_RESUME_ARGS=--json -m gpt-5.5 -c model_reasoning_effort="xhigh" --skip-git-repo-check --all

# Keep this on unless every WeChat chat that can reach the bot is trusted.
WECHAT_CODEX_PAIRING_REQUIRED=true

# Group chats only trigger normal prompts when the message starts with this value.
# Set to an empty value to disable the trigger.
WECHAT_CODEX_GROUP_TRIGGER=@codex

# Local state directory. Tokens and bridge state live here.
WECHAT_CODEX_HOME=~/.wechat-codex-bridge

# iLink defaults. Override only if the login flow returns a different host.
WECHAT_CODEX_BASE_URL=https://ilinkai.weixin.qq.com
WECHAT_CODEX_CDN_BASE_URL=https://novac2c.cdn.weixin.qq.com/c2c

# Delivery tuning.
WECHAT_CODEX_MIN_SEND_INTERVAL_MS=1500
WECHAT_CODEX_MAX_MESSAGE_BYTES=1800
WECHAT_CODEX_LONG_POLL_TIMEOUT_MS=35000
WECHAT_CODEX_INBOUND_MERGE_WINDOW_MS=3000

# Inbound media download and decrypt.
WECHAT_CODEX_DOWNLOAD_MEDIA=true
WECHAT_CODEX_MEDIA_MAX_BYTES=104857600

# Send official iLink typing state while Codex is working.
WECHAT_CODEX_TYPING_ENABLED=true

# Send a visible "Codex is working..." chat bubble before every task.
WECHAT_CODEX_WORKING_NOTICE=false

# Debug progress from Codex JSON events to stderr.
WECHAT_CODEX_DEBUG=false
